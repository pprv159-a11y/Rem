{
  "name": "remotion-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Automated vertical video creation with Remotion",
  "engines": { "node": ">=20 <23" },
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions src/index.ts",
    "render": "remotion render src/index.ts Main out/video.mp4 --codec=h264 --concurrency=2",
    "check": "npm run typecheck && npm run compositions",
    "build": "npm run check && npm run render"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "remotion": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.7.0"
  }
}
